local rawUrl = "https://raw.githubusercontent.com/cube20807-afk/Cicada-33202/main/Cicada.lua"

local success, content = pcall(function()
    return game:HttpGet(rawUrl)
end)

if success and content then
    local func, err = loadstring(content)
    if func then
        task.spawn(func)
    else
        warn("Loi syntax file goc: " .. tostring(err))
    end
else
    warn("Khong the tai script tu GitHub!")
end
